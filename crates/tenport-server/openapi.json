{
  "components": {
    "schemas": {
      "Author": {
        "properties": {
          "email": {
            "example": "1+enojen@users.noreply.github.com",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "Me": {
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "github": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizations": {
            "items": {
              "$ref": "#/components/schemas/MyOrganization"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "github",
          "organizations"
        ],
        "type": "object"
      },
      "MyOrganization": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ],
        "type": "object"
      },
      "NewProject": {
        "properties": {
          "name": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "repo": {
            "example": "enojen/tenport",
            "type": "string"
          }
        },
        "required": [
          "org",
          "name",
          "repo"
        ],
        "type": "object"
      },
      "NewRun": {
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "base": {
            "example": "main",
            "type": "string"
          },
          "class": {
            "example": "build",
            "type": "string"
          },
          "command": {
            "example": [
              "tenbox",
              "build",
              "TEN-301"
            ],
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-tenbox-commands": {
              "answer": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 1,
                "value_flags": []
              },
              "approve": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              },
              "build": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              },
              "check": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": [
                  "--group",
                  "--tier"
                ]
              },
              "close": {
                "before_task": [],
                "bool_flags": [
                  "--force"
                ],
                "positionals": 0,
                "value_flags": []
              },
              "decide": {
                "before_task": [],
                "bool_flags": [
                  "--no-build"
                ],
                "positionals": 0,
                "value_flags": [
                  "--json"
                ]
              },
              "plan": {
                "before_task": [
                  "show"
                ],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              },
              "pr": {
                "before_task": [],
                "bool_flags": [
                  "--ready",
                  "--force",
                  "--wait"
                ],
                "positionals": 0,
                "value_flags": []
              },
              "start": {
                "before_task": [],
                "bool_flags": [
                  "--force"
                ],
                "positionals": 0,
                "value_flags": [
                  "--title"
                ]
              },
              "status": {
                "before_task": [],
                "bool_flags": [],
                "positionals": 0,
                "value_flags": []
              }
            }
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "project": {
            "type": "string"
          },
          "services": {
            "example": [
              "postgres"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "setup": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task",
          "command",
          "base",
          "class",
          "author"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "type": "object"
      },
      "Project": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "org": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "org",
          "name",
          "repo"
        ],
        "type": "object"
      },
      "Recorded": {
        "properties": {
          "skipped": {
            "minimum": 0,
            "type": "integer"
          },
          "stored": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "stored",
          "skipped"
        ],
        "type": "object"
      },
      "ReportedEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TasksEvent"
          },
          {
            "properties": {
              "at": {
                "format": "date-time",
                "type": "string"
              },
              "id": {
                "example": "019a8f2e-7c4b-7d21-9a3e-5b8c1d2e3f40",
                "type": "string"
              }
            },
            "required": [
              "id",
              "at"
            ],
            "type": "object"
          }
        ]
      },
      "Role": {
        "enum": [
          "admin",
          "member"
        ],
        "type": "string"
      },
      "Run": {
        "properties": {
          "name": {
            "example": "task-ten-301-1117-101500",
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "name",
          "project",
          "task"
        ],
        "type": "object"
      },
      "RunPhase": {
        "enum": [
          "Running",
          "Succeeded",
          "Failed",
          "Unknown"
        ],
        "type": "string"
      },
      "RunState": {
        "properties": {
          "class": {
            "example": "build",
            "type": "string"
          },
          "command": {
            "example": "build",
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "example": "task-ten-301-1117-101500",
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/RunPhase"
          },
          "project": {
            "type": "string"
          },
          "reason": {
            "example": "OOMKilled",
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "name",
          "project",
          "task",
          "command",
          "class",
          "created",
          "phase"
        ],
        "type": "object"
      },
      "TaskClosed": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TaskStarted": {
        "properties": {
          "project": {
            "type": "string"
          },
          "task": {
            "example": "TEN-301",
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "project",
          "task"
        ],
        "type": "object"
      },
      "TasksEvent": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskStarted"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.started"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskClosed"
              },
              {
                "properties": {
                  "type": {
                    "enum": [
                      "task.closed"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "The backend of Tenyard",
    "license": {
      "name": "FSL-1.1-ALv2"
    },
    "title": "Tenport",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/events": {
      "post": {
        "operationId": "record_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ReportedEvent"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recorded"
                }
              }
            },
            "description": "The new events are stored; an id Tenport has is skipped"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a list of valid events"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of a project's organization"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "An id came before with other content, or an event does not fit the state; nothing is stored"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The database answers"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The database does not answer"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "The user of the token and their organizations"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "list_projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The projects of the user's organizations"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "add_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "The project is added"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a valid new project"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not an admin of the organization"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/runs": {
      "get": {
        "operationId": "list_runs",
        "parameters": [
          {
            "in": "query",
            "name": "project",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "TEN-301",
            "in": "query",
            "name": "task",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunState"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The runs of the task, the oldest first"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No project or task, or a task that is not a task id"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of the project's organization"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "start_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRun"
              }
            }
          },
          "description": "One tenbox command to run in a box",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "The Job of the run is created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The body is not a valid run: an unknown command, class or service"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of the project's organization"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A Job of the task still runs (code machine-busy)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/runs/{name}": {
      "delete": {
        "operationId": "stop_run",
        "parameters": [
          {
            "description": "The name of the run, the name of its Job",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The run is stopped: its Job and pod are deleted, or were gone"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of the project's organization"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tenport does not know the run"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "get": {
        "operationId": "find_run",
        "parameters": [
          {
            "description": "The name of the run, the name of its Job",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            },
            "description": "The run, with the phase of its Job"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of the project's organization"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tenport does not know the run"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/runs/{name}/log": {
      "get": {
        "operationId": "read_log",
        "parameters": [
          {
            "description": "The name of the run, the name of its Job",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "follow",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The log of the box container; with follow=true it stays open until the container ends"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Tenport does not know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The user is not a member of the project's organization"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Tenport does not know the run"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The box container has not started, or the Job is gone"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  }
}
